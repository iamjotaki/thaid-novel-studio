# ReadAWrite Studio SaaS Environment Variables
# Copy this file to .env and fill in your keys

# Server Port (Default: 8080)
PORT=8080

# Google Gemini API Key (For AI Novel Generation & Polish)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom session secret or JWT secret
SESSION_SECRET=change_this_to_a_random_secure_key
